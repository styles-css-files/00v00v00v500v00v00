<style>
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#05070b;
 -webkit-touch-callout:none;-webkit-user-select:none;-moz-user-select:none;user-select:none}
*{overflow:hidden}
#stage{position:fixed;inset:0;background:#05070b;display:flex;align-items:center;justify-content:center}
#unity-canvas{display:block;background:#05070b;outline:none;max-width:100%;max-height:100%}

#boot{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;
 opacity:1;transition:opacity .6s ease}
#boot.fade{opacity:0;pointer-events:none}
#boot.gone{display:none}
#bg{position:absolute;inset:0;background:radial-gradient(85% 60% at 50% 40%, #16202e 0%, #0b1119 48%, #05070b 100%)}
#win{position:absolute;left:50%;top:48%;width:min(440px,78vw);height:min(300px,46vh);transform:translate(-50%,-50%);
 pointer-events:none;opacity:.5;
 background:linear-gradient(180deg, rgba(150,185,225,.16), rgba(80,110,150,.05) 60%, transparent);
 box-shadow:0 0 90px 30px rgba(110,150,200,.10);
 animation:glow 7s ease-in-out infinite}
#win:before,#win:after{content:"";position:absolute;background:rgba(10,14,20,.75)}
#win:before{left:50%;top:0;bottom:0;width:3px;transform:translateX(-50%)}
#win:after{top:50%;left:0;right:0;height:3px;transform:translateY(-50%)}
@keyframes glow{0%,100%{opacity:.42}50%{opacity:.62}}
#rain{position:absolute;inset:-20%;pointer-events:none;opacity:.16;
 background:repeating-linear-gradient(104deg,rgba(185,215,255,.55) 0 1px,transparent 1px 7px);
 animation:fall 1.5s linear infinite}
@keyframes fall{to{transform:translate3d(-60px,180px,0)}}
#veil{position:absolute;inset:0;pointer-events:none;
 background:radial-gradient(66% 52% at 50% 45%, rgba(0,0,0,0) 26%, rgba(2,4,7,.80) 76%, rgba(1,2,4,.97) 100%);
