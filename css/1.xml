@keyframes breathe{0%,100%{opacity:.93}50%{opacity:1}}
#grain{position:absolute;inset:0;pointer-events:none;opacity:.18;mix-blend-mode:overlay;
 background-image:radial-gradient(rgba(255,255,255,.5) .5px,transparent .6px);background-size:3px 3px;
 animation:jit .8s steps(2) infinite}
@keyframes jit{0%{transform:translate(0,0)}50%{transform:translate(1px,-1px)}100%{transform:translate(-1px,1px)}}

#in{position:relative;display:flex;flex-direction:column;align-items:center;gap:15px;padding:0 22px;text-align:center;max-width:620px}
#ttl{margin:0;font:700 clamp(18px,3.2vw,29px)/1.2 Georgia,"Times New Roman",serif;letter-spacing:.3em;
 text-transform:uppercase;color:#dde8f5;
 text-shadow:0 2px 0 rgba(0,0,0,.9),0 0 24px rgba(120,170,230,.45),0 0 60px rgba(60,100,160,.4);
 animation:flick 6s linear infinite}
@keyframes flick{0%,95%,100%{opacity:1}96%{opacity:.4}96.7%{opacity:.95}97.6%{opacity:.3}98.4%{opacity:.92}}
#sub{margin:0;font:400 clamp(9px,1.4vw,11px)/1.7 Georgia,serif;letter-spacing:.3em;text-transform:uppercase;color:#7e94ad}
#rule{width:76px;height:1px;background:linear-gradient(90deg,transparent,#5f87b5,transparent);opacity:.9}
#bar{position:relative;width:min(390px,76vw);height:7px;border-radius:2px;background:rgba(255,255,255,.07);
 box-shadow:inset 0 0 0 1px rgba(120,170,220,.26),inset 0 2px 6px rgba(0,0,0,.7)}
#fill{position:relative;overflow:hidden;width:0%;height:100%;border-radius:inherit;
 transition:width .4s cubic-bezier(.25,.8,.3,1);
 background:linear-gradient(90deg,#1d3c5e,#3f79b4 58%,#9fc8ee);box-shadow:0 0 14px rgba(90,150,215,.6)}
#fill:after{content:"";position:absolute;inset:0;pointer-events:none;
 background:linear-gradient(90deg,transparent,rgba(235,245,255,.42),transparent);
 background-size:38% 100%;background-repeat:no-repeat;animation:sweep 2.3s linear infinite}
@keyframes sweep{from{background-position:-45% 0}to{background-position:145% 0}}
#pct{font:600 11px/1 ui-monospace,Consolas,monospace;letter-spacing:.3em;color:#bed6ee}
#msg{min-height:16px;font:400 italic clamp(11px,1.6vw,13px)/1.5 Georgia,serif;color:#8198b0;
 transition:opacity .5s ease;opacity:1}
#msg.out{opacity:0}
#rl{display:none;margin-top:4px;border:0;border-radius:3px;padding:11px 28px;cursor:pointer;
 font:700 11px/1 Georgia,serif;letter-spacing:.2em;text-transform:uppercase;
 background:linear-gradient(180deg,#3f79b4,#20486e);color:#eaf3ff}
#boot.err #rl{display:block}
#boot.err #msg{color:#f0a89a;font-style:normal}
#boot.err #fill{background:linear-gradient(90deg,#4a1a12,#8a3524)}
#boot.err #fill:after{display:none}
#boot.err #ttl{animation:none}
@media (prefers-reduced-motion:reduce){#win,#rain,#veil,#grain,#ttl,#fill:after{animation:none}#fill{transition:none}}
</style>
